# ─────────────────────────────────────────────────────────────
#  Track (วิชาเสริม ม.4-6) — environment.  Copy to .env and fill in.
#  NEVER commit the real .env.  All secrets live here, not in code.
#
#  The database is NOT created by this stack. It lives in the shared
#  `postgres-core` container (network: school-net) as database `tracks`,
#  owned by role `tracks`. Credentials are issued by the postgres-core
#  stack's own .env (TRACKS_DB_PASSWORD) — mirror that value here.
# ─────────────────────────────────────────────────────────────

# Host port for the app (fixed to avoid clashing with other SchoolOS stacks)
APP_PORT=3004

# Path prefix nginx serves the app under. Passed to the image as a BUILD arg and
# compiled into the bundle + every /_next/* URL — changing it requires
# `docker compose up -d --build`, not just a restart. nginx must pass the prefix
# through (proxy_pass with NO trailing slash) — see deploy/nginx-track.conf.
# Set empty for a dedicated subdomain / root-mounted deploy.
BASE_PATH=/tracks

# Container clock. Display dates already pin Asia/Bangkok in code; this covers
# backup filenames and log timestamps.
TZ=Asia/Bangkok

# ── Database ────────────────────────────────────────────────
# Used by the containers: resolves `postgres-core` by name over school-net.
DATABASE_URL_INTERNAL=postgres://tracks:change-me-tracks@postgres-core:5432/tracks

# Used when running the app OUTSIDE docker (npm run dev): postgres-core
# publishes 5432 on the host.
DATABASE_URL=postgres://tracks:change-me-tracks@localhost:5432/tracks

# ── Session ─────────────────────────────────────────────────
# Session signing (own JWT — NOT SchoolOS). Use a long random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app REFUSES TO START in production while this is still the example value:
# it is published in this repository, so anyone could sign themselves an admin
# session with it.
JWT_SECRET=change-me-to-a-long-random-secret

# Idle timeout. A session is renewed automatically while it is being used, so
# this is how long an UNUSED one survives — not how long a working day can be.
# Accepts 30m / 12h / 1d.
JWT_EXPIRES_IN=12h

# Hard ceiling on one login, however active. Even a session in constant use
# ends here and asks for the password again. Default 24.
SESSION_MAX_HOURS=24

# Defaults to TRUE — the session cookie is then refused over plain HTTP.
# Set it to false ONLY for a plain-HTTP LAN deployment (http://<ip>:3004);
# behind the school's HTTPS nginx leave it alone.
# COOKIE_SECURE=false

# ── SchoolOS Public API (Identity Provider) ─────────────────
SCHOOLOS_API_BASE_URL=http://192.168.200.56:3002
SCHOOLOS_API_KEY=sk_live_your_key_here

# ── Automatic roster sync ───────────────────────────────────
# Minutes between background syncs of ปีการศึกษา → นักเรียน → ครู → ครูที่ปรึกษา.
# One catch-up run happens ~20s after boot, but only if the last run is older
# than this, so restarts don't re-sync. Floor is 5; set 0 to disable and go back
# to pressing the buttons on หน้าซิงก์รายชื่อ. Default when unset: 360 (6 ชม.).
AUTO_SYNC_INTERVAL_MINUTES=360

# ── Backups ─────────────────────────────────────────────────
# Where the in-app backup page writes pg_dump archives. Inside docker this is
# the tracks_backups volume; for npm run dev any local folder works.
BACKUP_DIR=./backups

# ── First-run admin ─────────────────────────────────────────
# Read at startup by src/instrumentation.ts. Creates the local admin ONLY when
# the database holds none — it never overwrites an existing admin, so changing
# these later does nothing. There is no seed step in the deploy.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_NAME=ผู้ดูแลระบบ
