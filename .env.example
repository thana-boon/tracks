# ─────────────────────────────────────────────────────────────
#  Track (วิชาเสริม ม.4-6) — environment.  Copy to .env and fill in.
#  NEVER commit the real .env.  All secrets live here, not in code.
#
#  The database is NOT created by this stack. It lives in the shared
#  `postgres-core` container (network: school-net) as database `tracks`,
#  owned by role `tracks`. Credentials are issued by the postgres-core
#  stack's own .env (TRACKS_DB_PASSWORD) — mirror that value here.
# ─────────────────────────────────────────────────────────────

# Host port for the app (fixed to avoid clashing with other SchoolOS stacks)
APP_PORT=3004

# Path prefix nginx serves the app under. Passed to the image as a BUILD arg and
# compiled into the bundle + every /_next/* URL — changing it requires
# `docker compose up -d --build`, not just a restart. nginx must pass the prefix
# through (proxy_pass with NO trailing slash) — see deploy/nginx-track.conf.
# Set empty for a dedicated subdomain / root-mounted deploy.
BASE_PATH=/tracks

# Container clock. Display dates already pin Asia/Bangkok in code; this covers
# backup filenames and log timestamps.
TZ=Asia/Bangkok

# ── Database ────────────────────────────────────────────────
# Used by the containers: resolves `postgres-core` by name over school-net.
DATABASE_URL_INTERNAL=postgres://tracks:change-me-tracks@postgres-core:5432/tracks

# Used when running the app OUTSIDE docker (npm run dev): postgres-core
# publishes 5432 on the host.
DATABASE_URL=postgres://tracks:change-me-tracks@localhost:5432/tracks

# ── Session ─────────────────────────────────────────────────
# Session signing (own JWT — NOT SchoolOS). Use a long random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app REFUSES TO START in production while this is still the example value:
# it is published in this repository, so anyone could sign themselves an admin
# session with it.
JWT_SECRET=change-me-to-a-long-random-secret

# Idle timeout. A session is renewed automatically while it is being used, so
# this is how long an UNUSED one survives — not how long a working day can be.
# Accepts 30m / 12h / 1d.
#
# MUST NOT exceed the SchoolOS idle window (Users: SESSION_IDLE_MINUTES, 15).
# A longer one here means this app goes on believing in a session SchoolOS has
# already forgotten — the app warns at startup if you set one. Working sessions
# are kept alive on real activity (typing, clicking), both here and upstream,
# so 15m is not "signed out every quarter of an hour"; it is how long a machine
# nobody is touching stays open.
JWT_EXPIRES_IN=15m

# Hard ceiling on one login, however active. Even a session in constant use
# ends here and asks for the password again. Default 8 — one school day, and
# the same ceiling the platform puts on the session this one comes from.
SESSION_MAX_HOURS=8

# Defaults to TRUE — the session cookie is then refused over plain HTTP.
# Set it to false ONLY for a plain-HTTP LAN deployment (http://<ip>:3004);
# behind the school's HTTPS nginx leave it alone.
# COOKIE_SECURE=false

# ── SchoolOS Public API (Identity Provider) ─────────────────
# Where OUR SERVER reaches SchoolOS. An internal address, used only for
# server-to-server calls carrying X-API-Key. Never put this in anything the
# browser has to fetch — most user machines cannot reach that port at all.
SCHOOLOS_API_BASE_URL=http://192.168.200.56:3002
SCHOOLOS_API_KEY=sk_live_your_key_here

# ── Silent SSO (SchoolOS handoff) ───────────────────────────
# Someone already signed in to SchoolOS opens this system and is simply in.
# Someone who is not sees the ordinary login form — nothing hangs, nothing
# errors. Turn the whole thing off with SSO_ENABLED=false.
#
# Before this can work, the SchoolOS admin must give this system's API key the
# `auth:handoff` scope AND fill in "ระบบปลายทาง (audience)". Check it yourself:
#   curl -H "X-API-Key: <this key>" http://192.168.200.56:3002/api/public/v1/me
# `scopes` must contain auth:handoff, and `handoffAudience` is the value to put
# in SCHOOLOS_SSO_AUDIENCE below.

# Where the BROWSER reaches SchoolOS Users. A path, not a URL: nginx serves
# every SchoolOS system from one host, so /users is same-origin with us — which
# is why the SchoolOS cookie is sent automatically and no CORS setup is needed.
SCHOOLOS_USERS_WEB_BASE=/users

# The audience this system's API key is bound to.
SCHOOLOS_SSO_AUDIENCE=tracks

# Where a browser goes when it has no session here — the SchoolOS front door.
# It is sent STRAIGHT here the moment a session ends (idle timeout, the absolute
# cap, or the SchoolOS session behind it going away), with no stop at this app's
# own login page: signing in again is something only SchoolOS can do. A visitor
# who was never signed in pauses on /login just long enough for SchoolOS to
# answer "nobody is signed in here", and is then sent on too — once per five
# minutes, so a bookmark cannot ping-pong between the two systems.
# It is also the `next` of the SchoolOS logout, so signing out lands there.
#
# An absolute URL is deliberate: this must be right even when the app is opened
# by IP or from another host. Keep it on the same origin as the Users Service,
# or add it to that service's SSO_ALLOWED_ORIGINS — it refuses any other `next`.
# Leave it unset (or "/") and every one of those journeys stays on this app's
# own login form instead, which is the right setting only for a root-mounted
# deploy with no portal to go back to.
#
# The local ผู้ดูแล is never sent there, whatever this says: they have no
# SchoolOS account, and this form is their way in on the day SchoolOS is down.
SCHOOLOS_PORTAL_URL=https://schoolos.sukhon.ac.th

# SSO_ENABLED=false

# Running `npm run dev` on its own port is a different origin from the real
# Users Service, so silent SSO will not fire and the login form appears as
# normal. Nothing is broken. To test SSO locally you must run SchoolOS Users
# locally too (a production cookie cannot reach localhost), point
# SCHOOLOS_USERS_WEB_BASE at it, and have the admin add your dev origin to
# SSO_ALLOWED_ORIGINS — exact match, scheme + host + port, no trailing slash.

# ── Automatic roster sync ───────────────────────────────────
# Minutes between background syncs of ปีการศึกษา → นักเรียน → ครู → ครูที่ปรึกษา.
# One catch-up run happens ~20s after boot, but only if the last run is older
# than this, so restarts don't re-sync. Floor is 5; set 0 to disable and go back
# to pressing the buttons on หน้าซิงก์รายชื่อ. Default when unset: 360 (6 ชม.).
AUTO_SYNC_INTERVAL_MINUTES=360

# ── Backups ─────────────────────────────────────────────────
# Where the in-app backup page writes pg_dump archives. Inside docker this is
# the tracks_backups volume; for npm run dev any local folder works.
BACKUP_DIR=./backups

# ── First-run admin ─────────────────────────────────────────
# Read at startup by src/instrumentation.ts. Creates the local admin ONLY when
# the database holds none — it never overwrites an existing admin, so changing
# these later does nothing. There is no seed step in the deploy.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_NAME=ผู้ดูแลระบบ
