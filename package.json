{
  "name": "tracks",
  "version": "1.0.0",
  "private": true,
  "description": "Track — ระบบวิชาเสริม ม.4-6 โรงเรียนสุคนธีรวิทย์ (SchoolOS satellite)",
  "scripts": {
    "predev": "node scripts/copy-fonts.mjs",
    "dev": "next dev -p 3004",
    "prebuild": "node scripts/copy-fonts.mjs",
    "build": "next build",
    "start": "next start -p 3004 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/evaluate.test.ts src/lib/attendance-summary.test.ts src/lib/session-core.test.ts src/lib/session-end.test.ts src/lib/password.test.ts src/lib/render-queue.test.ts src/lib/track-grades.test.ts src/lib/track-window.test.ts src/lib/class-order.test.ts src/lib/xlsx.test.ts src/lib/track-report.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "seed:admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.1.6",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fontkit": "^2.0.4",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.5.20",
    "postgres": "^3.4.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
